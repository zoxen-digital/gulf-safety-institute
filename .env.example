# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers)
MONGODB_URI=
# Database name inside the cluster
MONGODB_DB_NAME=gistra

# Session signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Public canonical URL. Used for QR codes, password reset links, sitemap and origin checks.
APP_URL=http://localhost:3000

# Initial Super Admin, created by `npm run seed` only if no user with this email exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# true = also seed clearly-labelled DEMO trainees/certificates. Never enable on production.
SEED_DEMO_DATA=false

# SMTP for inquiry notifications and password reset emails. Leave blank to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
NOTIFICATION_EMAIL=
